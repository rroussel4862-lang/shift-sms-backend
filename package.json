{
  "name": "shift-sms-backend",
  "version": "1.0.0",
  "description": "Sends real SMS to staff when a manager posts an open shift, and lets staff claim it by texting back.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/env.setup.js"
    ],
    "globalSetup": "<rootDir>/tests/global.setup.js",
    "globalTeardown": "<rootDir>/tests/global.teardown.js",
    "testTimeout": 15000
  }
}
