# Copy this file to .env and fill in your real values. Never commit .env.

# From twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number you bought, in E.164 format
TWILIO_PHONE_NUMBER=+15551234567

# Port the server listens on (most hosts override this automatically)
PORT=3000

# The public HTTPS URL this server will be reachable at once deployed.
# Used only for the startup log message + to build the webhook URL to paste into Twilio.
# Example: https://your-app.onrender.com
PUBLIC_URL=

# Optional: comma-separated list of origins allowed to call this API from a browser.
# Leave blank during setup/testing to allow all origins.
ALLOWED_ORIGINS=
